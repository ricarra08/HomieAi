NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
OPENAI_API_KEY=your_openai_api_key
GEOAPIFY_KEY=your_geoapify_api_key
# Shared secret used by /api/collaborator/upload to authorize its server-to-server call
# to /api/documents/process. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your_internal_api_secret

# Transactional email (Resend). Optional: if RESEND_API_KEY is unset, email sends are
# skipped gracefully (no errors). Verify the sending domain in Resend before going live.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Phazr <notifications@phazr.co>"
# Canonical site origin used for links inside emails (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=https://phazr.co
